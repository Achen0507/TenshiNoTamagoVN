      "backgroundPath": "Image/Backgrounds/0_2(bu)",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "红天里没有云。只有一种缓慢的、让人想闭眼的压迫感。  \n 天空随时要掉下来了。",
      "autoNextSeconds": 0,
      "options": [],
      "eggDelta": 0,
