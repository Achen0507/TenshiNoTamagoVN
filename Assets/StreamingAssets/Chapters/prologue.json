      "characterSpritePath": "Image/Sprites/m_stand",
      "characterPosition": "left",
      "descriptionText": "他背着那东西——像剑，但柄是十字形的。\n更像一个被铸成锋刃的十字架。",
      "autoNextSeconds": 0,
      "options": [],
      "eggDelta": 0
