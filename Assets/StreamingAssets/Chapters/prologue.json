      "options": [],
      "eggDelta": 0
    },
        {
      "id": 2,
      "backgroundPath": "Image/Backgrounds/0_1",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "枝干像肋骨一样撑开。",
      "autoNextSeconds": 0,
      "options": [],
      "eggDelta": 0
    },
            {
      "id": 3,
      "backgroundPath": "Image/Backgrounds/0_1",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "蛋不是蛋，是遗忘的开始。",
      "autoNextSeconds": 0,
      "options": [],
      "eggDelta": 0
    },
                {
      "id": 509,
      "backgroundPath": "Image/Backgrounds/0_1",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "它挂在枝桠间，像一颗从未跳动过的心脏。",
      "autoNextSeconds": 0,
      "options": [],
      "eggDelta": 0
    },
                    {
      "id": 521,
      "backgroundPath": "Image/Backgrounds/0_1",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "根须扎进虚空。 \n 树冠托着一个不破的沉默。",
      "autoNextSeconds": 0,
      "options": [],
      "eggDelta": 0
    },
                    {
      "id": 510,
      "backgroundPath": "Image/Backgrounds/0_1",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "依稀可见骨骼的结构，和瞳孔的形状。",
      "autoNextSeconds": 0,
      "options": [],
      "eggDelta": 0
    },
                        {
      "id": 511,
      "backgroundPath": "Image/Backgrounds/0_1",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "然而漆黑一片的天空下，已再无生命的孕育。",
      "autoNextSeconds": 0,
      "options": [],
      "eggDelta": 0
    },
    {
      "id": 4,
      "backgroundPath": "Image/Backgrounds/0_2",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "天是红的，不是夕阳。\n是锈。",
      "autoNextSeconds": 0,
      "options": [],
      "eggDelta": 0
    },
        {
      "id": 518,
      "backgroundPath": "Image/Backgrounds/0_2",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "空气是干的。\n 风里没有水汽，只有灰。",
      "autoNextSeconds": 0,
      "options": [],
      "eggDelta": 0
    },
        {
      "id": 5,
      "backgroundPath": "Image/Backgrounds/0_2",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "远处有建筑残骸，像被拔掉肋骨的胸腔。",
