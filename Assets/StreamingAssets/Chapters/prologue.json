      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "隐约能看出拱顶和尖塔。曾经是教堂，现在是被剖开的兽骨。 \n 怪诞的造型，让人心生恐惧。",
      "autoNextSeconds": 0,
      "options": [],
      "eggDelta": 0,
      "isAnimation": false,
      "animationSpeed": 0,
