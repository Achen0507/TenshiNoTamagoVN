      "options": [],
      "eggDelta": 0
    },
    {
      "id": 521,
      "backgroundPath": "Image/Backgrounds/0_1",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "根は虚無へと伸びる。\n樹冠は、破れぬ沈黙を抱いている。",
      "autoNextSeconds": 0,
      "options": [],
      "eggDelta": 0
    },
    {
      "id": 510,
      "backgroundPath": "Image/Backgrounds/0_1",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "かすかに見えるのは、骨格と、瞳の形だ。",
