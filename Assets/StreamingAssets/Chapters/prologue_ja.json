      "options": [],
      "eggDelta": 0
    },
    {
      "id": 511,
      "backgroundPath": "Image/Backgrounds/0_1",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "だが漆黒の空の下、もはや命が育まれることはない。",
