      "options": [],
      "eggDelta": 0
    },
    {
      "id": 518,
      "backgroundPath": "Image/Backgrounds/0_2",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "空気は乾いている。\n風に湿り気はなく、ただ灰だけが舞う。",
