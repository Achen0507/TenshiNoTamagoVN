      "options": [],
      "eggDelta": 0
    },
    {
      "id": 4,
      "backgroundPath": "Image/Backgrounds/0_2",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "空は赤い。夕焼けではない。\n錆びの色だ。",
