    {
      "id": 509,
      "backgroundPath": "Image/Backgrounds/0_1",
      "characterSpritePath": "",
      "characterPosition": "",
      "descriptionText": "それは枝の間にぶら下がり、一度も鼓動したことのない心臓のようだ。",
